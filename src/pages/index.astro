4.59-1.96.59-3.37 0-1.38-.197-2.49-.59-3.33-.392-.83-.959-1.46-1.698-1.9-.717-.46-1.595-.76-2.635-.9a25.34 25.34 0 0 0-3.432-.21v12.62Z"
                          style="fill: rgb(26, 26, 26);" class="fills" data-testid="svg-path"/>
                </svg>
                <span class="name-hidden">Paritosh Pundir</span>

            </h1>
            <p class="tag-line">Helping small businesses and startups solve problems through <span>pixels</span> and RGB motion.</p>
        </section>

        <section class="about-section content-section">
            <div class="section-inner">
                <span class="section-label">About</span>
                <div class="about-body">
                    <p>
                        I'm a self-taught full-stack developer and technology consultant based in
                        <strong>Dehradun, India</strong>, with over <strong>14 years</strong> of experience
                        in web design and development. I work with small businesses, startups, and international
                        clients to turn ideas into polished digital products.
                    </p>
                    <p>
                        I specialize in picking technology stacks that balance scalability with simplicity —
                        building things that work well without over-engineering them.
                    </p>
                </div>
            </div>
        </section>

        <section class="skills-section content-section">
            <div class="section-inner">
                <span class="section-label">Skills</span>
                <div class="skills-grid">
                    {skills.map((group) => (
                        <div class="skill-group">
                            <h3 class="skill-category">{group.category}</h3>
                            <ul class="skill-list">
                                {group.items.map((item) => (
                                    <li class="skill-item">{item}</li>
                                ))}
                            </ul>
                        </div>
                    ))}
                </div>
            </div>
        </section>

        <section class="projects-section content-section">
            <div class="section-inner">
                <span class="section-label">Projects</span>
                <div class="projects-grid">
                    {projects.map((project) => (
                        project.href ? (
                            <a class="project-card" href={project.href} target="_blank" rel="noopener noreferrer">
                                <div class="project-top">
                                    <h3 class="project-title">{project.title}</h3>
                                    {project.stars !== null && (
                                        <span class="project-stars">★ {project.stars}</span>
                                    )}
                                </div>
                                <p class="project-desc">{project.description}</p>
                                {project.lang && (
                                    <span class="project-lang">{project.lang}</span>
                                )}
                            </a>
                        ) : (
                            <div class="project-card project-card--static">
                                <div class="project-top">
                                    <h3 class="project-title">{project.title}</h3>
                                </div>
                                <p class="project-desc">{project.description}</p>
                            </div>
                        )
                    ))}
                </div>
            </div>
        </section>

        <footer class="site-footer">
            <div class="footer-inner">
                <span class="footer-copy">Paritosh Pundir &mdash; Dehradun, India</span>
                <nav class="footer-links">
                    <a href="https://github.com/Paari" target="_blank" rel="noopener noreferrer">GitHub</a>
                    <a href="https://www.linkedin.com/in/paritosh-pundir" target="_blank" rel="noopener noreferrer">LinkedIn</a>
                    <a href="https://dribbble.com/paritosh_pundir" target="_blank" rel="noopener noreferrer">Dribbble</a>
                </nav>
            </div>
        </footer>
    </main>
</Layout>

<style>
    main {
        position: relative;
        overflow: hidden;
        color: #1a1a1a;
    }

    .rgb-canvas {
        position: fixed;
        inset: 0;
        z-index: -1;
        background:
                radial-gradient(circle at 20% 10%, rgba(214, 69, 69, 0.05), transparent 45%),
                radial-gradient(circle at 80% 25%, rgba(46, 158, 91, 0.05), transparent 50%),
                radial-gradient(circle at 40% 80%, rgba(74, 91, 208, 0.05), transparent 45%),
                linear-gradient(140deg, #ffffff 0%, #f5f6f8 100%);
    }

    .rgb-canvas::before {
        content: '';
        position: absolute;
        inset: 0;
        background-image:
                linear-gradient(rgba(0, 0, 0, 0.03) 1px, transparent 1px),
                linear-gradient(90deg, rgba(0, 0, 0, 0.03) 1px, transparent 1px);
        background-size: 24px 24px;
        opacity: 0.6;
    }

    .rgb-pixel {
        position: absolute;
        width: 10px;
        height: 10px;
        border-radius: 2px;
        opacity: 0.5;
        animation: pixelFloat 8s ease-in-out infinite;
    }

    .rgb-pixel--r {
        color: #d64545;
        background: currentColor;
        left: 10%;
        top: 30%;
    }

    .rgb-pixel--g {
        color: #2e9e5b;
        background: currentColor;
        right: 12%;
        top: 58%;
        animation-delay: 1.8s;
    }

    .rgb-pixel--b {
        color: #4a5bd0;
        background: currentColor;
        left: 74%;
        top: 16%;
        animation-delay: 3.1s;
    }

    .main-header {
        height: 80px;
        display: flex;
        align-items: center;
        padding: 0 1rem;
    }

    .logo {
        display: inline-block;
        width: 40px;
        height: 40px;
        position: relative;
    }

    .logo svg {
        transition: transform 0.5s;
        z-index: 1;
        position: relative;
    }

    .logo:hover {
        width: 150px;
    }

    .logo:hover svg {
        transform: rotate(90deg);
        animation: changeColor 3s infinite ease-in-out;
    }

    .logo-tag {
        position: absolute;
        left: 0;
        top: 0;
        text-transform: uppercase;
        transition: left 0.4s, letter-spacing 0.6s;
        line-height: 25px;
        letter-spacing: -8px;
        color: #1a1a1a;
    }

    .logo:hover .logo-tag {
        letter-spacing: 2px;
        left: 34px;
    }

    .name-wrapper {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        justify-content: center;
        height: calc(100vh - 100px);
        padding: 0 4rem;
    }

    .name {
        position: relative;
        margin: 0;
    }

    .name svg {
        width: 100%;
        height: auto;
        filter: none;
    }

    .name::before {
        content: '';
        position: absolute;
        inset: auto -2.5rem -0.75rem;
        height: 1px;
        background: linear-gradient(90deg, #d64545, #2e9e5b, #4a5bd0, #d64545);
        background-size: 220% 100%;
        animation: rgbShift 2.8s linear infinite;
    }

    .name:after {
        content: '';
        position: absolute;
        bottom: 6px;
        right: -16px;
        width: 8px;
        height: 8px;
        background-color: var(--color-red);
    }

    .name:hover.name:after {
        animation: changeColor 3s infinite linear;
    }

    .name-hidden {
        display: none;
    }

    @keyframes changeColor {
        0% {
            background-color: var(--color-red);
            box-shadow: 2px 2px 15px -3px var(--color-red);
        }
        45% {
            background-color: var(--color-green);
            box-shadow: 2px 2px 15px -3px var(--color-green);
        }
        75% {
            background-color: var(--color-blue);
            box-shadow: 2px 2px 15px -3px var(--color-blue);
        }
