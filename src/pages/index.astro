---
import Layout from '../layouts/Layout.astro';
import PixelHero from '../components/PixelHero.astro';
import Passes from '../components/Passes.astro';

const email = 'Paritosh.Pundir@outlook.com';

const projects = [
    {
        channel: 'r',
        category: 'Design & UX',
        title: 'Chrome Reader Extension',
        role: 'Creator & Maintainer',
        tag: '67 Stars',
        href: 'https://github.com/Paari/chrome-reader-extension',
        desc: 'Distraction-free reading experience for the web. Strips clutter, isolates typography, and provides custom dark and paper themes.',
        tech: ['React', 'Chrome MV3', 'Tailwind', 'Zero-Tracking'],
    },
    {
        channel: 'g',
        category: 'Architecture & Systems',
        title: 'Fitbit Health Explorer',
        role: 'Open Source',
        tag: 'Local-First',
        href: 'https://github.com/Paari/fitbit-health-explorer',
        desc: 'Local-first personal health analytics engine computing sleep stages, readiness scores, and strain trends via Google Health APIs.',
        tech: ['TypeScript', 'SQLite', 'Charts', 'Google API'],
    },
    {
        channel: 'b',
        category: 'Product & Workflow',
        title: 'DoRemember',
        role: 'Design & Code',
        tag: 'Productivity',
        href: null,
        desc: 'Zero-friction capture tool built for deep workers to record insights, schedule contextual reminders, and stay in uninterrupted flow.',
        tech: ['Astro', 'TypeScript', 'LocalStorage', 'Keyboard-First'],
    },
    {
        channel: 'g',
        category: 'Developer Tooling',
        title: 'Conventional Commit CLI',
        role: 'Open Source',
        tag: 'Terminal Tool',
        href: 'https://github.com/Paari/conventional-commit-cli',
        desc: 'Interactive terminal prompt enforcing standardized git commit conventions with fuzzy search and branch linting.',
        tech: ['Node.js', 'CLI', 'Git Hooks', 'Inquirer'],
    },
] as const;

const rituals = [
    {
        label: 'Workspace',
        val: 'Neovim + Ghostty',
        note: 'Pure keyboard flow, zero-latency editing ritual.',
    },
    {
        label: 'Tenure',
        val: '15 Years Building',
        note: 'From early web prototypes to scaled distributed SaaS.',
    },
    {
        label: 'Base',
        val: 'Dehradun, India',
        note: 'At the foothills of the Himalayas, working worldwide.',
    },
    {
        label: 'Mindset',
        val: 'State Cricket + Hindi Topper',
        note: 'Athletic stamina meets storytelling and precision.',
    },
] as const;
---

<Layout title="Paritosh Pundir, Designer & Developer">
    <header class="nav wrap">
        <a class="brand" href="#top" aria-label="Paritosh Pundir, top">
            <span class="brand-mark" aria-hidden="true">
                <span class="brand-px brand-px--r"></span>
                <span class="brand-px brand-px--g"></span>
                <span class="brand-px brand-px--b"></span>
            </span>
            <span class="brand-name">PARITOSH PUNDIR</span>
            <span class="brand-role">/ DESIGNER &amp; DEVELOPER</span>
        </a>
        <nav class="nav-links">
            <a class="nav-anchor" href="#passes">The RGB Method</a>
            <a class="nav-anchor" href="#work">Selected Work</a>
            <a class="nav-btn" href="#contact">Get in touch</a>
        </nav>
    </header>

    <main id="top">
        <!-- Full-Width Unboxed Hero Section -->
        <section class="hero-section" aria-label="Introduction">
            <!-- Full width canvas stage: edge-to-edge unboxed -->
            <div class="hero-stage">
                <PixelHero name="PARITOSH PUNDIR" />
            </div>

            <div class="wrap hero-statement">
                <h1 class="visually-hidden">Paritosh Pundir, Designer &amp; Developer</h1>
                <p class="hero-lead">
                    I turn scattered ideas into products people actually use.
                </p>
                <p class="hero-subtext">
                    Fifteen years at the overlap of design systems, resilient web architecture, and product leadership. Based in Dehradun.
                </p>
                <div class="hero-actions">
                    <a href="#work" class="hero-btn hero-btn--primary">
                        <span>Explore Selected Work</span>
                        <span class="btn-arrow" aria-hidden="true">&rarr;</span>
                    </a>
                    <a href="#passes" class="hero-btn hero-btn--secondary">
                        <span>The RGB Method</span>
                        <span class="btn-arrow" aria-hidden="true">&darr;</span>
                    </a>
                </div>
            </div>
        </section>

        <!-- The RGB Narrative Section -->
        <div id="passes">
            <Passes />
        </div>

        <!-- Selected Work Bento Grid -->
        <section class="work wrap" id="work" aria-labelledby="work-heading">
            <div class="section-header" data-reveal>
                <h2 id="work-heading" class="section-title">Selected Work</h2>
                <p class="section-sub">
                    A sample of tools, open-source projects, and systems built with care.
                </p>
            </div>

            <div class="projects-grid">
                {
                    projects.map((p, i) => (
                        <article class={`project-card project-card--${p.channel}`} data-reveal style={`--i: ${i}`}>
                            <div class="card-meta">
                                <span class="card-badge">
                                    <span class="badge-dot"></span>
                                    {p.category}
                                </span>
                                <span class="card-tag">{p.tag}</span>
                            </div>
                            <h3 class="card-title">
                                {p.href ? (
                                    <a href={p.href} target="_blank" rel="noopener noreferrer" class="card-link">
                                        {p.title}
                                        <span class="link-arrow" aria-hidden="true">&nearr;</span>
                                    </a>
                                ) : (
                                    <span>{p.title}</span>
                                )}
                            </h3>
                            <p class="card-desc">{p.desc}</p>
                            <div class="card-tech">
                                {p.tech.map((t) => (
                                    <span class="tech-pill">{t}</span>
                                ))}
                            </div>
                        </article>
                    ))
                }
            </div>
        </section>

        <!-- The Workshop & Rituals -->
        <section class="rituals wrap" aria-labelledby="rituals-heading" data-reveal>
            <div class="rituals-inner">
                <h2 id="rituals-heading" class="rituals-title">The Workshop &amp; Rituals</h2>
                <p class="rituals-sub">
                    Generalist versatility backed by 15 years of continuous discipline.
                </p>

                <div class="rituals-grid">
                    {
                        rituals.map((r) => (
                            <div class="ritual-cell">
                                <span class="ritual-label">{r.label}</span>
                                <strong class="ritual-val">{r.val}</strong>
                                <span class="ritual-note">{r.note}</span>
                            </div>
                        ))
                    }
                </div>
            </div>
        </section>

        <!-- Contact Section -->
        <footer class="contact wrap" id="contact" aria-labelledby="contact-heading">
            <div class="contact-box" data-reveal>
                <h2 id="contact-heading" class="contact-head">
                    Let's make
                    <span class="misreg" data-misreg>
                        <span class="misreg-layer misreg-layer--r" aria-hidden="true">something</span>
                        <span class="misreg-layer misreg-layer--g" aria-hidden="true">something</span>
                        <span class="misreg-layer misreg-layer--b">something</span>
                    </span>.
                </h2>
                <p class="contact-lead">
                    Open for select consulting, leadership roles, and early product builds.
                </p>

                <div class="contact-action">
                    <a class="contact-email" href={`mailto:${email}`}>
                        <span>{email}</span>
                        <span class="contact-email-arrow" aria-hidden="true">&rarr;</span>
                    </a>
                </div>

                <div class="contact-foot">
                    <span>Dehradun, India. Open to collaborate worldwide.</span>
                    <nav class="contact-social" aria-label="Profiles">
                        <a href="https://github.com/Paari" target="_blank" rel="noopener noreferrer">GitHub</a>
                        <a href="https://www.linkedin.com/in/paritosh-pundir" target="_blank" rel="noopener noreferrer">LinkedIn</a>
                        <a href="https://dribbble.com/paritosh_pundir" target="_blank" rel="noopener noreferrer">Dribbble</a>
                    </nav>
                </div>
            </div>
        </footer>
    </main>
</Layout>

<script>
    // Chromatic alignment on contact element when in view
    const word = document.querySelector<HTMLElement>('[data-misreg]');
    if (word) {
        const io = new IntersectionObserver(
            (entries) => {
                const e = entries[0];
                if (!e?.isIntersecting) return;
                setTimeout(() => word.classList.add('is-registered'), 300);
                io.disconnect();
            },
            { threshold: 0.5 },
        );
        io.observe(word);
    }
</script>

<style>
    /* Navigation ----------------------------------------------------- */
    .nav {
        height: 72px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        border-bottom: 1px solid var(--line);
    }

    .brand {
        display: inline-flex;
        align-items: center;
        gap: 0.75rem;
        text-decoration: none;
    }

    .brand-mark {
        position: relative;
        width: 32px;
        height: 10px;
    }

    .brand-px {
        position: absolute;
        top: 0;
        width: 9px;
        height: 9px;
        mix-blend-mode: multiply;
        transition: transform 0.4s var(--ease);
    }

    .brand-px--r { left: 0; background: rgb(var(--r)); }
    .brand-px--g { left: 11px; background: rgb(var(--g)); }
    .brand-px--b { left: 22px; background: rgb(var(--b)); }

    .brand:hover .brand-px--r { transform: translateX(11px); }
    .brand:hover .brand-px--b { transform: translateX(-11px); }

    .brand-name {
        font-family: var(--font-pixel);
        font-size: 0.875rem;
        letter-spacing: 0.02em;
    }

    .brand-role {
        font-family: var(--font-mono);
        font-size: 0.75rem;
        color: var(--ink-faint);
    }

    .nav-links {
        display: inline-flex;
        align-items: center;
        gap: 1.5rem;
    }

    .nav-anchor {
        font-family: var(--font-mono);
        font-size: 0.8125rem;
        color: var(--ink-soft);
        text-decoration: none;
        transition: color 0.2s;
    }

    .nav-anchor:hover {
        color: var(--ink);
    }

    .nav-btn {
        font-family: var(--font-mono);
        font-size: 0.8125rem;
        text-decoration: none;
        padding: 0.45rem 0.85rem;
        border: 1px solid var(--ink);
        background: transparent;
        color: var(--ink);
        transition: all 0.2s var(--ease);
    }

    .nav-btn:hover {
        background: var(--ink);
        color: var(--paper);
    }

    /* Hero ----------------------------------------------------------- */
    .hero-section {
        padding-top: clamp(1.5rem, 4vh, 2.75rem);
        padding-bottom: clamp(3.5rem, 8vh, 6rem);
        display: flex;
        flex-direction: column;
        gap: clamp(1.5rem, 3vh, 2.5rem);
    }

    .hero-top {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .hero-eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        font-family: var(--font-mono);
        font-size: 0.75rem;
        letter-spacing: 0.04em;
        color: var(--ink-faint);
    }

    .badge-dot {
        width: 6px;
        height: 6px;
        background: var(--g-text);
        box-shadow: 0 0 6px var(--g-text);
    }

    .hero-stage {
        width: 100%;
        overflow: hidden;
    }

    .hero-statement {
        display: flex;
        flex-direction: column;
        gap: 1.25rem;
        max-width: 54rem;
        padding-top: 1.75rem;
        border-top: 1px solid var(--line);
    }

    .hero-lead {
        font-size: clamp(1.6rem, 3.2vw, 2.75rem);
        font-weight: 500;
        letter-spacing: -0.03em;
        line-height: 1.15;
        margin: 0;
    }

    .hero-subtext {
        font-size: clamp(1.05rem, 1.4vw, 1.25rem);
        color: var(--ink-soft);
        max-width: 48ch;
        line-height: 1.55;
        margin: 0;
    }

    .hero-actions {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 1rem;
        margin-top: 0.5rem;
    }

    .hero-btn {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        font-family: var(--font-mono);
        font-size: 0.875rem;
        text-decoration: none;
        padding: 0.65rem 1.25rem;
        transition: all 0.2s var(--ease);
    }

    .hero-btn--primary {
        background: var(--ink);
        color: var(--paper);
        border: 1px solid var(--ink);
    }

    .hero-btn--primary:hover {
        background: transparent;
        color: var(--ink);
    }

    .hero-btn--secondary {
        background: var(--paper);
        color: var(--ink);
        border: 1px solid var(--line);
    }

    .hero-btn--secondary:hover {
        border-color: var(--ink);
    }

    .btn-arrow {
        transition: transform 0.2s var(--ease);
    }

    .hero-btn:hover .btn-arrow {
        transform: translateX(3px);
    }

    .hero-btn--secondary:hover .btn-arrow {
        transform: translateY(3px);
    }

    /* Section Headers ------------------------------------------------ */
    .section-header {
        max-width: 48rem;
        margin-bottom: clamp(2.5rem, 6vh, 4rem);
    }

    .section-tag {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        font-family: var(--font-mono);
        font-size: 0.75rem;
        letter-spacing: 0.08em;
        color: var(--ink-faint);
        margin-bottom: 0.75rem;
    }

    .tag-channel {
        width: 8px;
        height: 8px;
    }

    .tag-channel--r { background: var(--r-text); }
    .tag-channel--g { background: var(--g-text); }
    .tag-channel--b { background: var(--b-text); }

    .section-title {
        font-size: clamp(2.25rem, 5vw, 3.5rem);
        font-weight: 600;
        letter-spacing: -0.035em;
        margin: 0 0 0.75rem;
    }

    .section-sub {
        font-size: 1.125rem;
        color: var(--ink-soft);
        margin: 0;
    }

    /* Selected Work Grid --------------------------------------------- */
    .work {
        padding-block: clamp(5rem, 12vh, 8rem);
        border-top: 1px solid var(--line);
    }

    .projects-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 1.5rem;
    }

    .project-card {
        padding: clamp(1.5rem, 4vw, 2.5rem);
        border: 1px solid var(--line);
        background: var(--paper);
        display: flex;
        flex-direction: column;
        gap: 1rem;
        position: relative;
        transition: transform 0.25s var(--ease), border-color 0.25s var(--ease), box-shadow 0.25s var(--ease);
    }

    .project-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 12px 30px -10px rgb(var(--ink-rgb) / 0.08);
    }

    .project-card--r:hover { border-color: var(--r-text); }
    .project-card--g:hover { border-color: var(--g-text); }
    .project-card--b:hover { border-color: var(--b-text); }

    .card-meta {
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-family: var(--font-mono);
        font-size: 0.75rem;
    }

    .card-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        color: var(--ink-soft);
    }

    .project-card--r .card-badge .badge-dot { background: var(--r-text); box-shadow: 0 0 6px var(--r-text); }
    .project-card--g .card-badge .badge-dot { background: var(--g-text); box-shadow: 0 0 6px var(--g-text); }
    .project-card--b .card-badge .badge-dot { background: var(--b-text); box-shadow: 0 0 6px var(--b-text); }

    .card-tag {
        color: var(--ink-faint);
    }

    .card-title {
        font-size: clamp(1.4rem, 2vw, 1.85rem);
        font-weight: 600;
        letter-spacing: -0.025em;
        margin: 0;
    }

    .card-link {
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
    }

    .link-arrow {
        transition: transform 0.2s var(--ease);
    }

    .card-link:hover .link-arrow {
        transform: translate(2px, -2px);
    }

    .card-desc {
        font-size: 0.9375rem;
        line-height: 1.55;
        color: var(--ink-soft);
        margin: 0;
        flex: 1 1 auto;
    }

    .card-tech {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        padding-top: 0.75rem;
        border-top: 1px dashed var(--line);
    }

    .tech-pill {
        font-family: var(--font-mono);
        font-size: 0.75rem;
        padding: 0.2rem 0.55rem;
        background: rgb(var(--ink-rgb) / 0.04);
        color: var(--ink-soft);
    }

    /* Rituals Section ------------------------------------------------ */
    .rituals {
        padding-block: clamp(4rem, 10vh, 7rem);
        border-top: 1px solid var(--line);
    }

    .rituals-inner {
        max-width: 64rem;
    }

    .rituals-title {
        font-size: clamp(2rem, 4vw, 3rem);
        font-weight: 600;
        letter-spacing: -0.03em;
        margin: 0 0 0.5rem;
    }

    .rituals-sub {
        font-size: 1.05rem;
        color: var(--ink-soft);
        margin: 0 0 clamp(2rem, 5vh, 3.5rem);
    }

    .rituals-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 1.5rem;
    }

    .ritual-cell {
        display: flex;
        flex-direction: column;
        gap: 0.4rem;
        padding: 1.25rem;
        border: 1px solid var(--line);
        background: var(--paper);
    }

    .ritual-label {
        font-family: var(--font-mono);
        font-size: 0.75rem;
        letter-spacing: 0.05em;
        color: var(--ink-faint);
    }

    .ritual-val {
        font-family: var(--font-pixel);
        font-size: 1rem;
        letter-spacing: 0.01em;
        color: var(--ink);
    }

    .ritual-note {
        font-size: 0.8125rem;
        line-height: 1.4;
        color: var(--ink-soft);
    }

    /* Contact Section ------------------------------------------------ */
    .contact {
        padding-block: clamp(5rem, 12vh, 9rem) clamp(2rem, 5vh, 3rem);
        border-top: 1px solid var(--line);
    }

    .contact-box {
        max-width: 64rem;
    }

    .contact-head {
        font-size: clamp(2.75rem, 8vw, 6.5rem);
        font-weight: 600;
        letter-spacing: -0.04em;
        line-height: 1.02;
        margin: 0 0 1rem;
    }

    .misreg {
        position: relative;
        display: inline-grid;
        font-family: var(--font-pixel);
        font-weight: 500;
    }

    .misreg-layer {
        grid-area: 1 / 1;
        mix-blend-mode: multiply;
        transition: transform 1.2s var(--ease);
    }

    .misreg-layer--r { color: rgb(var(--r)); transform: translate(-0.06em, -0.03em); }
    .misreg-layer--g { color: rgb(var(--g)); transform: translate(0.05em, 0.02em); }
    .misreg-layer--b { color: rgb(var(--b)); transform: translate(0.02em, 0.06em); }

    .misreg.is-registered .misreg-layer {
        transform: none;
    }

    .contact-lead {
        font-size: clamp(1.1rem, 1.6vw, 1.35rem);
        color: var(--ink-soft);
        max-width: 44ch;
        margin: 0 0 clamp(2rem, 5vh, 3.5rem);
    }

    .contact-action {
        margin-bottom: clamp(3rem, 8vh, 5rem);
    }

    .contact-email {
        display: inline-flex;
        align-items: baseline;
        gap: 0.75rem;
        font-size: clamp(1.4rem, 3.2vw, 2.5rem);
        font-weight: 500;
        letter-spacing: -0.02em;
        text-decoration: none;
        padding-bottom: 0.35rem;
        background-image:
            linear-gradient(rgb(var(--r)), rgb(var(--r))),
            linear-gradient(rgb(var(--g)), rgb(var(--g))),
            linear-gradient(rgb(var(--b)), rgb(var(--b)));
        background-repeat: no-repeat;
        background-size: 100% 2px;
        background-position:
            0 calc(100% - 6px),
            0 calc(100% - 3px),
            0 100%;
        transition: background-position 0.35s var(--ease);
    }

    .contact-email:hover {
        background-position:
            0 100%,
            0 100%,
            0 100%;
    }

    .contact-email-arrow {
        display: inline-block;
        transition: transform 0.3s var(--ease);
    }

    .contact-email:hover .contact-email-arrow {
        transform: translateX(0.35em);
    }

    .contact-foot {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 1rem 2rem;
        padding-top: 1.5rem;
        border-top: 1px solid var(--line);
        font-family: var(--font-mono);
        font-size: 0.8125rem;
        color: var(--ink-faint);
    }

    .contact-social {
        display: flex;
        gap: 1.5rem;
    }

    .contact-social a {
        color: var(--ink);
        text-decoration: none;
        transition: color 0.2s;
    }

    .contact-social a:hover {
        color: var(--b-text);
    }

    @media (prefers-color-scheme: dark) {
        .brand-px,
        .misreg-layer {
            mix-blend-mode: screen;
        }
    }

    @media (max-width: 900px) {
        .rituals-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .hero-statement {
            grid-template-columns: 1fr;
        }

        .hero-pillars {
            grid-template-columns: 1fr;
        }
    }

    @media (max-width: 767px) {
        .brand-role,
        .nav-anchor {
            display: none;
        }

        .projects-grid {
            grid-template-columns: 1fr;
        }

        .rituals-grid {
            grid-template-columns: 1fr;
        }
    }
</style>
