---
import Layout from '../layouts/Layout.astro';

const skills = [
    { category: 'Frontend', items: ['React', 'Next.js', 'TypeScript', 'Astro'] },
    { category: 'Backend', items: ['Node.js', 'PHP', 'Laravel', 'Go'] },
    { category: 'Mobile', items: ['Flutter', 'Android', 'Dart', 'Kotlin'] },
    { category: 'Cloud & Tools', items: ['AWS', 'Supabase', 'Firebase', 'UX/UI Design'] },
];

const projects = [
    {
        title: 'Chrome Reader Extension',
        description: 'A Google Chrome extension built in React for a distraction-free reading experience.',
        href: 'https://github.com/Paari/chrome-reader-extension',
        stars: 67,
        lang: 'JavaScript',
    },
    {
        title: 'Fitbit Health Explorer',
        description: 'Open-source local-first Fitbit health dashboard with recovery, sleep, strain & readiness scores via Google Health API.',
        href: 'https://github.com/Paari/fitbit-health-explorer',
        stars: 2,
        lang: 'JavaScript',
    },
    {
        title: 'Conventional Commit CLI',
        description: 'A terminal tool for creating conventional commit messages with an interactive prompt.',
        href: 'https://github.com/Paari/conventional-commit-cli',
        stars: 2,
        lang: 'JavaScript',
    },
    {
        title: 'DoRemember',
        description: 'A productivity app to help you capture and remember important things at the right time.',
        href: null,
        stars: null,
        lang: null,
    },
];
---

<Layout title="Paritosh Pundir">
    <main>
        <div class="rgb-canvas" aria-hidden="true">
            <span class="rgb-pixel rgb-pixel--r"></span>
            <span class="rgb-pixel rgb-pixel--g"></span>
            <span class="rgb-pixel rgb-pixel--b"></span>
        </div>
        <header class="main-header">
          <span class="logo">
            <svg width="25" height="25" viewBox="0 0 25 25" fill="none" xmlns="http://www.w3.org/2000/svg">
              <rect width="25" height="25" fill="#232323"/>
            </svg>

            <span class="logo-tag">Believe</span>
          </span>
        </header>

        <section class="name-wrapper">
            <h1 class="name">
                <svg width="811.578" xmlns="http://www.w3.org/2000/svg" height="53.87"
                     viewBox="-577.269 1371.75 811.578 53.87" fill="none">
