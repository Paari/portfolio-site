---
import Layout from '../layouts/Layout.astro';
import HairlineFigure from '../components/HairlineFigure.astro';

const passes = [
    {
        key: 'R',
        channel: 'red',
        title: 'Design',
        role: 'first, the idea',
        figure: 'riffle',
        body: 'I take something scattered and give it a shape and a story, deciding what to leave out so the rest can breathe.',
    },
    {
        key: 'G',
        channel: 'green',
        title: 'Build',
        role: 'then, the make',
        figure: 'branches',
        body: 'I turn that shape into working software, choosing stacks that scale without over-engineering them.',
    },
    {
        key: 'B',
        channel: 'blue',
        title: 'Lead',
        role: 'then, the rise',
        figure: 'elevator',
        body: 'I grow the team around the work and help people climb past their own doubts, so it reaches further than I could carry alone.',
    },
] as const;
---

<Layout title="Paritosh Pundir — Designer & Developer">
    <header class="topbar">
        <span class="mark" aria-hidden="true">
            <span class="mark-dot mark-dot--r"></span>
            <span class="mark-dot mark-dot--g"></span>
            <span class="mark-dot mark-dot--b"></span>
        </span>
        <span class="topbar-meta">Paritosh Pundir / Designer &amp; Developer</span>
        <a class="topbar-link" href="mailto:Paritosh.Pundir@outlook.com">Get in touch</a>
    </header>

    <main>
        <section class="hero">
            <div class="hero-text">
                <p class="eyebrow">Fifteen years at the overlap of design, code and people</p>
                <h1 class="hero-name" data-text="Paritosh Pundir">Paritosh Pundir</h1>
                <p class="hero-lead">I turn scattered ideas into products people actually use.</p>
                <p class="hero-support">
                    A screen paints every frame in three passes of light: red, green and blue. I
                    make products the same way. When design, build and reach point one direction,
                    the passes resolve into a single picture.
                </p>
            </div>
        </section>

        <section class="pipeline" aria-labelledby="pipeline-heading">
            <div class="section-head">
                <h2 id="pipeline-heading">Three passes, one picture.</h2>
                <p>Three line drawings on one thread. Each colour is a single pass of the same work, woven down until they coil into the thing a person opens and uses.</p>
            </div>

            <div class="pipeline-body">
                <div class="pipeline-main">
                    <ol class="stages">
                        {passes.map((p) => (
                            <li class={`stage stage--${p.channel}`}>
                                <div class="stage-figure">
                                    <HairlineFigure
                                        figure={p.figure}
                                        channel={p.channel}
                                        intensity={0.6}
                                        label={`The ${p.title} pass, drawn as an interactive ${p.figure} figure`}
                                    />
                                </div>
                                <div class="stage-copy">
                                    <span class="stage-role">{p.key} &middot; {p.role}</span>
                                    <h3 class="stage-title">{p.title}</h3>
                                    <p class="stage-text">{p.body}</p>
                                </div>
                            </li>
                        ))}
                    </ol>

                    <div class="onepicture">
                        <h3 class="onepicture-title">Back into one picture.</h3>
                        <p class="onepicture-text">
                            Pull the three passes together and they stop reading as separate. Design,
                            build and reach become one product: the thing a person opens and uses.
                        </p>
                    </div>
                </div>

                <div class="rail" aria-hidden="true">
                    <svg class="rail-weave" viewBox="0 0 100 100" preserveAspectRatio="none">
                        <path class="thread thread--r" d="M20,0 C40,12 60,20 50,30 C42,40 24,48 30,62 C38,74 55,82 50,100" />
                        <path class="thread thread--g" d="M50,0 C50,14 50,22 50,32 C50,44 50,52 50,62 C50,74 50,86 50,100" />
                        <path class="thread thread--b" d="M80,0 C60,12 40,20 50,30 C58,40 76,48 70,62 C62,74 45,82 50,100" />
                    </svg>
                    <figure class="rail-knot-wrap">
                        <svg class="rail-knot" viewBox="0 0 120 126">
                            <path class="thread thread--r" d="M60,0 C56,10 50,20 48,28" />
                            <path class="thread thread--g" d="M60,0 C64,10 70,20 72,28" />
                            <path class="thread thread--b" d="M60,0 C60,20 60,38 60,52" />
                            <circle class="ring ring--r" cx="48" cy="62" r="34" />
                            <circle class="ring ring--g" cx="72" cy="62" r="34" />
                            <circle class="ring ring--b" cx="60" cy="86" r="34" />
                        </svg>
                        <figcaption class="venn-caption">R + G + B &rarr; one picture</figcaption>
                    </figure>
                </div>
            </div>
        </section>

        <footer class="contact" aria-labelledby="contact-heading">
            <p class="contact-kicker">Say hello</p>
            <h2 id="contact-heading" class="contact-head">Let's make <span class="rgb-split">something</span>.</h2>
            <a class="contact-email" href="mailto:Paritosh.Pundir@outlook.com">
                <span class="contact-email-label">Paritosh.Pundir@outlook.com</span>
                <span class="contact-email-arrow" aria-hidden="true">&rarr;</span>
            </a>
            <div class="contact-foot">
                <span class="contact-place">Dehradun, India &middot; open to work worldwide</span>
                <nav class="contact-links">
                    <a href="https://github.com/Paari" target="_blank" rel="noopener noreferrer">GitHub</a>
                    <a href="https://www.linkedin.com/in/paritosh-pundir" target="_blank" rel="noopener noreferrer">LinkedIn</a>
                    <a href="https://dribbble.com/paritosh_pundir" target="_blank" rel="noopener noreferrer">Dribbble</a>
                </nav>
            </div>
        </footer>
    </main>
</Layout>

<style>
    .topbar {
        display: flex;
        align-items: center;
        gap: 1rem;
        padding: 1.5rem clamp(1.5rem, 5vw, 5rem);
        border-bottom: 1px solid var(--line);
    }

    .mark {
        display: inline-flex;
        gap: 4px;
    }

    .mark-dot {
        width: 9px;
        height: 9px;
    }

    .mark-dot--r { background: var(--color-red); }
    .mark-dot--g { background: var(--color-green); }
    .mark-dot--b { background: var(--color-blue); }

    .topbar-meta {
        font-family: var(--font-mono);
        font-size: 0.82rem;
        letter-spacing: 0.01em;
        color: var(--ink-soft);
    }

    .topbar-link {
        margin-left: auto;
        font-family: var(--font-mono);
        font-size: 0.82rem;
        color: var(--ink);
        text-decoration: none;
        border-bottom: 1px solid var(--ink);
        padding-bottom: 2px;
    }

    .topbar-link:hover {
        color: var(--color-red);
        border-color: var(--color-red);
    }

    main {
        display: block;
    }

    /* Hero ----------------------------------------------------------- */
    .hero {
        padding: clamp(4rem, 12vh, 9rem) clamp(1.5rem, 5vw, 5rem) clamp(3.5rem, 9vh, 7rem);
        position: relative;
    }

    .hero::before {
        content: '';
        position: absolute;
        inset: 0;
        background-image:
            linear-gradient(var(--line) 1px, transparent 1px),
            linear-gradient(90deg, var(--line) 1px, transparent 1px);
        background-size: 48px 48px;
        -webkit-mask-image: radial-gradient(circle at 30% 40%, #000, transparent 70%);
        mask-image: radial-gradient(circle at 30% 40%, #000, transparent 70%);
        opacity: 0.5;
        pointer-events: none;
        z-index: 0;
    }

    .hero-text {
        position: relative;
        z-index: 1;
    }

    .eyebrow {
        font-family: var(--font-mono);
        font-size: 0.85rem;
        color: var(--ink-faint);
        margin: 0 0 1.25rem;
    }

    .hero-name {
        font-size: clamp(2.75rem, 9vw, 6.5rem);
        font-weight: 700;
        letter-spacing: -0.03em;
        margin: 0;
        color: var(--ink);
        /* The name split into its RGB channels. */
        text-shadow:
            0.018em 0 0 rgba(var(--red), 0.6),
            -0.018em 0 0 rgba(var(--blue), 0.6),
            0 0.015em 0 rgba(var(--green), 0.4);
        transition: text-shadow 0.4s cubic-bezier(0.2, 0.8, 0.2, 1);
    }

    .hero-name:hover {
        text-shadow:
            0.05em 0 0 rgba(var(--red), 0.75),
            -0.05em 0 0 rgba(var(--blue), 0.75),
            0 0.03em 0 rgba(var(--green), 0.5);
    }

    .hero-lead {
        font-size: clamp(1.3rem, 2.6vw, 1.9rem);
        font-weight: 500;
        line-height: 1.3;
        max-width: 18ch;
        margin: 1.75rem 0 1.25rem;
    }

    .hero-support {
        font-size: 1.05rem;
        color: var(--ink-soft);
        max-width: 44ch;
        margin: 0;
    }

    /* Pipeline: three passes woven into one picture ------------------ */
    .pipeline {
        padding: clamp(3.5rem, 8vh, 6rem) clamp(1.5rem, 5vw, 5rem);
        border-top: 1px solid var(--line);
    }

    .section-head {
        max-width: 60ch;
        margin-bottom: clamp(2.5rem, 5vh, 4rem);
    }

    .section-head h2 {
        font-size: clamp(1.9rem, 4vw, 3rem);
        margin: 0 0 0.75rem;
    }

    .section-head p {
        font-size: 1.1rem;
        color: var(--ink-soft);
        margin: 0;
    }

    .pipeline-body {
        display: grid;
        grid-template-columns: clamp(130px, 18vw, 210px) minmax(0, 1fr);
        grid-template-areas: 'rail main';
        gap: clamp(1.5rem, 5vw, 4rem);
        align-items: stretch;
    }

    /* The thread: three woven line drawings that coil into the circles. */
    .rail {
        grid-area: rail;
        position: relative;
        display: flex;
        flex-direction: column;
    }

    .rail-weave {
        flex: 1 1 auto;
        width: 100%;
        min-height: 140px;
    }

    .rail-knot-wrap {
        margin: 0;
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
    }

    .rail-knot {
        width: 100%;
        height: auto;
        overflow: visible;
    }

    .thread {
        fill: none;
        stroke-width: 2;
        stroke-linecap: round;
        vector-effect: non-scaling-stroke;
    }

    .ring {
        fill: none;
        stroke-width: 2;
        vector-effect: non-scaling-stroke;
    }

    .thread--r,
    .ring--r { stroke: var(--color-red); }
    .thread--g,
    .ring--g { stroke: var(--color-green); }
    .thread--b,
    .ring--b { stroke: var(--color-blue); }

    .venn-caption {
        font-family: var(--font-mono);
        font-size: 0.82rem;
        letter-spacing: 0.02em;
        color: var(--ink-faint);
    }

    .pipeline-main {
        grid-area: main;
        display: flex;
        flex-direction: column;
    }

    .stages {
        list-style: none;
        margin: 0;
        padding: 0;
        flex: 1 1 auto;
        display: flex;
        flex-direction: column;
    }

    .stage {
        display: grid;
        grid-template-columns: minmax(0, 260px) minmax(0, 1fr);
        gap: clamp(1.5rem, 4vw, 3rem);
        align-items: center;
        padding: clamp(1.75rem, 4vh, 2.75rem) 0;
    }

    .stage:first-child {
        padding-top: 0;
    }

    .stage + .stage {
        border-top: 1px solid var(--line);
    }

    .stage-figure {
        width: 100%;
    }

    .stage-role {
        display: block;
        font-family: var(--font-mono);
        font-size: 0.85rem;
        color: var(--ink-faint);
        margin-bottom: 0.5rem;
    }

    .stage-title {
        font-size: clamp(1.6rem, 3vw, 2.4rem);
        margin: 0 0 0.75rem;
    }

    .stage--red .stage-title { color: var(--color-red); }
    .stage--green .stage-title { color: var(--color-green); }
    .stage--blue .stage-title { color: var(--color-blue); }

    .stage-text {
        font-size: 1.1rem;
        color: var(--ink-soft);
        max-width: 54ch;
        margin: 0;
    }

    .onepicture {
        border-top: 1px solid var(--line);
        padding-top: clamp(1.75rem, 4vh, 2.75rem);
        margin-top: clamp(1.5rem, 3vh, 2rem);
    }

    .onepicture-title {
        font-size: clamp(1.9rem, 4vw, 3rem);
        margin: 0 0 1rem;
        max-width: 18ch;
    }

    .onepicture-text {
        font-size: 1.15rem;
        color: var(--ink-soft);
        max-width: 52ch;
        margin: 0;
    }

    /* Contact -------------------------------------------------------- */
    .contact {
        padding: clamp(4rem, 10vh, 7rem) clamp(1.5rem, 5vw, 5rem) clamp(3rem, 7vh, 5rem);
        border-top: 1px solid var(--line);
    }

    .contact-kicker {
        font-family: var(--font-mono);
        font-size: 0.85rem;
        color: var(--ink-faint);
        margin: 0 0 1rem;
    }

    .contact-head {
        font-size: clamp(2.4rem, 8vw, 5.5rem);
        font-weight: 700;
        letter-spacing: -0.03em;
        margin: 0 0 clamp(2rem, 5vh, 3rem);
    }

    .rgb-split {
        color: var(--ink);
        text-shadow:
            0.018em 0 0 rgba(var(--red), 0.6),
            -0.018em 0 0 rgba(var(--blue), 0.6),
            0 0.015em 0 rgba(var(--green), 0.4);
        transition: text-shadow 0.4s cubic-bezier(0.2, 0.8, 0.2, 1);
    }

    .contact-head:hover .rgb-split {
        text-shadow:
            0.05em 0 0 rgba(var(--red), 0.75),
            -0.05em 0 0 rgba(var(--blue), 0.75),
            0 0.03em 0 rgba(var(--green), 0.5);
    }

    .contact-email {
        display: inline-flex;
        align-items: center;
        gap: 0.6rem;
        font-size: clamp(1.3rem, 3.5vw, 2.4rem);
        font-weight: 500;
        color: var(--ink);
        text-decoration: none;
        padding-bottom: 0.3rem;
        background-image: linear-gradient(90deg, var(--color-red), var(--color-green), var(--color-blue));
        background-size: 100% 3px;
        background-repeat: no-repeat;
        background-position: 0 100%;
    }

    .contact-email-arrow {
        display: inline-block;
        transition: transform 0.3s cubic-bezier(0.2, 0.8, 0.2, 1);
    }

    .contact-email:hover .contact-email-arrow {
        transform: translateX(0.35em);
    }

    .contact-foot {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 1rem;
        margin-top: clamp(2.5rem, 6vh, 4rem);
    }

    .contact-place {
        font-family: var(--font-mono);
        font-size: 0.9rem;
        color: var(--ink-faint);
    }

    .contact-links {
        display: flex;
        gap: 1.75rem;
    }

    .contact-links a {
        font-family: var(--font-mono);
        font-size: 0.9rem;
        color: var(--ink);
        text-decoration: none;
    }

    .contact-links a:hover {
        color: var(--color-blue);
    }

    @media (max-width: 760px) {
        .pipeline-body {
            grid-template-columns: 1fr;
            grid-template-areas:
                'main'
                'rail';
        }

        .rail-weave {
            display: none;
        }

        .rail-knot-wrap {
            max-width: 280px;
            margin-top: clamp(1.5rem, 4vh, 2rem);
        }

        .stage {
            grid-template-columns: 1fr;
            gap: 1.25rem;
        }

        .stage-figure {
            max-width: 260px;
        }
    }
</style>
