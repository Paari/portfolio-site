---
interface Props {
    name: string;
}

const { name } = Astro.props;
---

<div class="pixel-hero" data-pixel-hero>
    <!-- Canvas handles the high-framerate chromatic aberration & subpixel physics -->
    <div class="hero-canvas-wrap">
        <canvas class="pixel-hero-canvas" aria-hidden="true"></canvas>
    </div>

    <!-- Accessible DOM text in Geist Pixel, always visible if JS is disabled -->
    <noscript>
        <h1 class="pixel-hero-fallback">{name}</h1>
    </noscript>
</div>

<script>
    import {
        readPalette,
        rgba,
        lerp,
        fitCanvas,
        textBitmap,
        type Palette,
    } from '../scripts/pixel';

    const root = document.querySelector<HTMLElement>('[data-pixel-hero]');
    const canvas = root?.querySelector<HTMLCanvasElement>('canvas');

    if (root && canvas) {
        const bitmap = textBitmap(['PARITOSH', 'PUNDIR'], 2);
        const PAD_ROWS = 1;

        let palette: Palette = readPalette();
        let ctx: CanvasRenderingContext2D;
        let cell = 14;
        let width = 0;
        let height = 0;
        let originX = 0;
        let originY = 0;
        let gridCols = 0;
        let gridRows = 0;

        const lit = new Set<string>();
        bitmap.cells.forEach((c) => lit.add(`${c.x},${c.y}`));

        const pointer = {
            x: -9999,
            y: -9999,
            tx: -9999,
            ty: -9999,
            on: 0,
            target: 0,
        };

        let raf = 0;

        const measure = () => {
            const wrap = root.getBoundingClientRect();
            // Calculate cell size based on available container width
            cell = Math.max(7, Math.min(19, Math.floor((wrap.width - 48) / bitmap.cols)));
            width = Math.max(320, wrap.width);
            height = (bitmap.rows + PAD_ROWS * 2) * cell;

            // Center the wordmark horizontally within the hero
            const wordmarkW = bitmap.cols * cell;
            originX = Math.max(0, Math.floor((width - wordmarkW) / 2));
            originY = PAD_ROWS * cell;

            gridCols = Math.ceil(width / cell) + 1;
            gridRows = bitmap.rows + PAD_ROWS * 2;

            ctx = fitCanvas(canvas, width, height);
            draw();
        };

        const draw = () => {
            ctx.clearRect(0, 0, width, height);

            const radius = cell * 5.2;
            const sigma2 = 2 * (radius * 0.55) ** 2;
            const amp = cell * 0.85 * pointer.on;

            // 1. Background Pixel Grid (CRT phosphor subpixels under loupe)
            ctx.globalCompositeOperation = 'source-over';

            for (let gy = 0; gy < gridRows; gy++) {
                for (let gx = 0; gx < gridCols; gx++) {
                    const cx = gx * cell + cell / 2;
                    const cy = gy * cell + cell / 2;
                    const bx = Math.floor((cx - originX) / cell);
                    const by = Math.floor((cy - originY) / cell);

                    // Skip cells that are occupied by the wordmark
                    if (lit.has(`${bx},${by}`)) continue;

                    const dx = cx - pointer.x;
                    const dy = cy - pointer.y;
                    const s = Math.exp(-(dx * dx + dy * dy) / sigma2) * pointer.on;

                    if (s > 0.05) {
                        // Under pointer loupe, unlit subpixels ignite in red, green, blue
                        const barW = cell * 0.2;
                        const barH = cell * 0.7 * (0.6 + 0.4 * s);
                        for (let k = 0; k < 3; k++) {
                            const ch = palette.channels[k];
                            if (!ch) continue;
                            ctx.fillStyle = rgba(ch, 0.75 * s);
                            ctx.fillRect(cx + (k - 1) * cell * 0.28 - barW / 2, cy - barH / 2, barW, barH);
                        }
                    }
                }
            }

            // 2. Wordmark Lit Pixels: Three RGB channel passes composited together
            ctx.globalCompositeOperation = palette.blend;
            const size = cell * 0.88;

            for (const c of bitmap.cells) {
                const cx = originX + c.x * cell + cell / 2;
                const cy = originY + c.y * cell + cell / 2;

                const dx = cx - pointer.x;
                const dy = cy - pointer.y;
                const dist = Math.hypot(dx, dy) || 1;
                const s = Math.exp(-(dist * dist) / sigma2);

                const ux = dx / dist;
                const uy = dy / dist;
                const m = amp * s;

                // Loupe channel offsets based on pointer proximity
                const off0: [number, number] = [ux * m, uy * m];
                const off1: [number, number] = [-uy * m * 0.35, ux * m * 0.35];
                const off2: [number, number] = [-ux * m, -uy * m];
                const offsets = [off0, off1, off2] as const;

                for (let k = 0; k < 3; k++) {
                    const ch = palette.channels[k];
                    const off = offsets[k];
                    if (!ch || !off) continue;

                    ctx.fillStyle = rgba(ch, 1);
                    ctx.fillRect(
                        cx - size / 2 + off[0],
                        cy - size / 2 + off[1],
                        size,
                        size,
                    );
                }
            }
        };

        const tick = () => {
            pointer.on = lerp(pointer.on, pointer.target, 0.15);
            pointer.x = lerp(pointer.x, pointer.tx, 0.22);
            pointer.y = lerp(pointer.y, pointer.ty, 0.22);

            draw();

            const isMoving =
                Math.abs(pointer.on - pointer.target) > 0.002 ||
                Math.abs(pointer.x - pointer.tx) > 0.4 ||
                Math.abs(pointer.y - pointer.ty) > 0.4;

            raf = isMoving ? requestAnimationFrame(tick) : 0;
        };

        const wake = () => {
            if (!raf) raf = requestAnimationFrame(tick);
        };

        const onMove = (e: PointerEvent) => {
            const rect = canvas.getBoundingClientRect();
            const x = e.clientX - rect.left;
            const y = e.clientY - rect.top;
            const inside = x >= 0 && x <= width && y >= 0 && y <= height;

            if (pointer.target === 0 && inside) {
                pointer.x = x;
                pointer.y = y;
            }
            pointer.tx = x;
            pointer.ty = y;
            pointer.target = inside ? 1 : 0;
            wake();
        };

        const onLeave = () => {
            pointer.target = 0;
            wake();
        };

        canvas.addEventListener('pointermove', onMove, { passive: true });
        canvas.addEventListener('pointerleave', onLeave);

        measure();
        new ResizeObserver(() => measure()).observe(root);

        window
            .matchMedia('(prefers-color-scheme: dark)')
            .addEventListener('change', () => {
                palette = readPalette();
                draw();
            });
    }
</script>

<style>
    .pixel-hero {
        position: relative;
        width: 100%;
        display: flex;
        flex-direction: column;
    }

    .hero-canvas-wrap {
        position: relative;
        width: 100%;
        overflow: hidden;
        background: transparent;
    }

    .pixel-hero-canvas {
        display: block;
        width: 100%;
        cursor: crosshair;
        touch-action: pan-y;
    }

    .pixel-hero-fallback {
        font-family: var(--font-pixel);
        font-size: clamp(2.5rem, 8vw, 6rem);
        line-height: 1;
        letter-spacing: -0.02em;
        margin: 0;
        text-transform: uppercase;
    }
</style>
