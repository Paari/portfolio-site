---
interface Props {
  title: string;
}

const {title} = Astro.props;
---

<!doctype html>
<html lang="en">
<head>
    <meta charset="UTF-8"/>
    <meta name="description"
          content="Paritosh Pundir the top full stack developer in Dehradun with high experience in Design and development"/>
    <meta name="viewport" content="width=device-width"/>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg"/>
    <meta name="generator" content={Astro.generator}/>
    <title>{title}</title>
</head>
<body>
<slot/>
</body>
</html>
<style is:global>
    @import url('https://fonts.googleapis.com/css2?family=Lato:ital,wght@0,100;0,300;0,400;0,700;0,900;1,100;1,300;1,400;1,700;1,900&display=swap');

    :root {
        --accent: 91, 110, 255;
        --accent-light: 220, 226, 255;
        --accent-dark: 27, 37, 87;
        --color-red: #ff4d4d;
        --color-green: #4dff88;
        --color-blue: #5b6eff;
        --accent-gradient: linear-gradient(
                45deg,
                rgb(var(--accent)),
                rgb(var(--accent-light)) 30%,
                rgb(var(--accent)) 60%
        );
    }

    html {
        font-family: "Lato", sans-serif;
        background: #070a14;
    }

    body {
        margin: 0;
        min-height: 100vh;
    }

    code {
        font-family: Menlo,
        Monaco,
        Lucida Console,
        Liberation Mono,
        DejaVu Sans Mono,
        Bitstream Vera Sans Mono,
        Courier New,
        monospace;
    }
</style>
